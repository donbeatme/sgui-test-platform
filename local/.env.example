# Copy to local/.env for a NEW deployment only. Do not replace an existing .env.
COMPOSE_PROJECT_NAME=guicase-next
DATABASE_TYPE=postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=wharttest
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-unique-database-password
DJANGO_ADMIN_USERNAME=admin
DJANGO_ADMIN_EMAIL=admin@example.com
DJANGO_ADMIN_PASSWORD=replace-with-your-admin-password
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
WHARTTEST_API_KEY=replace-with-a-long-random-mcp-key
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,frontend,host.docker.internal,testserver
WHARTTEST_BACKEND_URL=http://backend:8000
QDRANT_URL=http://qdrant:6333
USER_AGENT=SGUI

# Versions used by this installation; source is mounted from Django/ and Vue/dist/.
DOCKER_BACKEND_IMAGE=ghcr.io/mgdaaslab/wharttest-backend@sha256:c8396d960ee234a0e92002e15ff98579d95eddae3e16c73ccd3b0ed9fc938315
DOCKER_FRONTEND_IMAGE=ghcr.io/mgdaaslab/wharttest-frontend@sha256:d78fee9f07e5ed16d90fb0eaf3b477e109892371f9f6ba68aa1d931c043b6e88
DOCKER_MCP_IMAGE=ghcr.io/mgdaaslab/wharttest-mcp@sha256:3c2a0fc7d1a56e89f89a6d8644e483f370e234f8d5d265a978d0ea479df32409
DOCKER_PLAYWRIGHT_MCP_IMAGE=mcr.microsoft.com/playwright/mcp@sha256:dda1f7f9b812e22946635c8af7df9288b96d3b9e3f0f1b8576d6823e2031c1de
DOCKER_POSTGRES_IMAGE=postgres@sha256:cf78e76683b9ca8c5733cbbdce6c9262b45b6767934dd0a95e671f9a0fc20685
DOCKER_REDIS_IMAGE=redis@sha256:ff02b58f971e7d7d156a1267e283fcbbeee91773b6aa36c49dac28ecfe28eadf
DOCKER_QDRANT_IMAGE=qdrant/qdrant@sha256:12364fe851b9f17356fc88189fc06d1b521262e04659ec7345975b00c9246a10

# Optional MeterSphere connector; leave blank if unused.
MS_API_HOST=
MS_ACCESS_KEY=
MS_SECRET_KEY=
